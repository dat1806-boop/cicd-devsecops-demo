# Copy this file to .env only if you want to trigger GitHub Actions from the website.
# Fine-grained token: grant Actions = Read and write for this repository.
# Keep the token private. Never commit .env.
GITHUB_TOKEN=
GITHUB_REPOSITORY=dat1806-boop/cicd-devsecops-demo
GITHUB_WORKFLOW_FILE=pipeline.yml

# Optional: use a non-default local commit label on the deployed containers.
GIT_COMMIT=local-demo
